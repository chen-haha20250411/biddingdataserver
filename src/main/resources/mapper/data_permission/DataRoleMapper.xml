<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xiao.core.data_permission.mapper.DataRoleMapper">

    <resultMap id="BaseResultMap" type="com.xiao.core.data_permission.domain.DataRole">
        <id column="id" property="id" jdbcType="INTEGER" />
        <result column="role_name" property="roleName" jdbcType="VARCHAR" />
        <result column="role_code" property="roleCode" jdbcType="VARCHAR" />
        <result column="description" property="description" jdbcType="VARCHAR" />
        <result column="status" property="status" jdbcType="INTEGER" />
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP" />
        <result column="updated_at" property="updatedAt" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="Base_Column_List">
        id, role_name, role_code, description, status, created_at, updated_at
    </sql>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_role
        WHERE
        id = #{id}
    </select>

    <select id="queryAllRoles" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_role
        ORDER BY id
    </select>

    <select id="queryByRoleCode" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_role
        WHERE
        role_code = #{roleCode}
    </select>

    <select id="queryByStatus" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_role
        WHERE
        status = #{status}
        ORDER BY id
    </select>

    <insert id="insert" parameterType="com.xiao.core.data_permission.domain.DataRole">
        <selectKey resultType="java.lang.Integer" keyProperty="id" order="AFTER">
            SELECT @@IDENTITY
        </selectKey>
        INSERT INTO data_role(
            role_name, role_code, description, status, created_at, updated_at
        ) VALUES(
            #{roleName}, #{roleCode}, #{description}, #{status}, now(), now()
        )
    </insert>

    <update id="update" parameterType="com.xiao.core.data_permission.domain.DataRole">
        UPDATE data_role
        SET
            <if test="roleName != null and roleName != ''">
                role_name = #{roleName},
            </if>
            <if test="roleCode != null and roleCode != ''">
                role_code = #{roleCode},
            </if>
            <if test="description != null">
                description = #{description},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            updated_at = now()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM data_role WHERE id = #{id}
    </delete>

</mapper>
