<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xiao.core.data_permission.mapper.DataPermissionMapper">

    <resultMap id="BaseResultMap" type="com.xiao.core.data_permission.domain.DataPermission">
        <id column="id" property="id" jdbcType="INTEGER" />
        <result column="role_id" property="roleId" jdbcType="INTEGER" />
        <result column="permission_type" property="permissionType" jdbcType="VARCHAR" />
        <result column="permission_value" property="permissionValue" jdbcType="VARCHAR" />
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP" />
    </resultMap>

    <sql id="Base_Column_List">
        id, role_id, permission_type, permission_value, created_at
    </sql>

    <select id="queryById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_permission
        WHERE
        id = #{id}
    </select>

    <select id="queryByRoleId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_permission
        WHERE
        role_id = #{roleId}
    </select>

    <select id="queryByPermissionType" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM
        data_permission
        WHERE
        permission_type = #{permissionType}
    </select>

    <insert id="insert" parameterType="com.xiao.core.data_permission.domain.DataPermission">
        <selectKey resultType="java.lang.Integer" keyProperty="id" order="AFTER">
            SELECT @@IDENTITY
        </selectKey>
        INSERT INTO data_permission(
            role_id, permission_type, permission_value, created_at
        ) VALUES(
            #{roleId}, #{permissionType}, #{permissionValue}, now()
        )
    </insert>

    <update id="update" parameterType="com.xiao.core.data_permission.domain.DataPermission">
        UPDATE data_permission
        SET
            <if test="roleId != null">
                role_id = #{roleId},
            </if>
            <if test="permissionType != null and permissionType != ''">
                permission_type = #{permissionType},
            </if>
            <if test="permissionValue != null and permissionValue != ''">
                permission_value = #{permissionValue},
            </if>
            created_at = now()
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.Integer">
        DELETE FROM data_permission WHERE id = #{id}
    </delete>

    <delete id="deleteByRoleId" parameterType="java.lang.Integer">
        DELETE FROM data_permission WHERE role_id = #{roleId}
    </delete>

</mapper>
